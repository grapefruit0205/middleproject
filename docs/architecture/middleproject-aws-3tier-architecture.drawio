        <mxCell id="p3-e3" value="03 · HTTP 8080" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=4;fontSize=12;endSize=13;fontStyle=1;fontColor=#C2410C;labelBackgroundColor=#FFFFFF;labelBorderColor=#CBD5E1;rounded=1;arcSize=16;jettySize=26;jumpStyle=arc;jumpSize=10;dashPattern=1 0;exitX=0;exitY=0.5;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="p3-1" source="p3-ialb" target="p3-was-a">
