        <mxCell id="p3-korean-guide" value="" style="rounded=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;" vertex="1" parent="p3-1">
          <mxGeometry x="50" y="1105.0" width="1400.0" height="464" as="geometry" />
        </mxCell>
        <mxCell id="p3-guide-title" value="&lt;b&gt;한글 흐름 설명&lt;/b&gt; · 그림의 화살표 번호와 함께 읽으세요" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=21;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p3-1">
          <mxGeometry x="72" y="1123.0" width="1356.0" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p3-guide-1" value="&lt;b&gt;01 WEB01 → 내부 ALB&lt;/b&gt;&lt;br&gt;가용 영역 A의 Apache가 애플리케이션 요청을 내부 ALB의 HTTP 80 리스너로 전달합니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p3-1">
          <mxGeometry x="72.0" y="1177.0" width="668.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p3-guide-2" value="&lt;b&gt;02 WEB02 → 내부 ALB&lt;/b&gt;&lt;br&gt;가용 영역 C의 Apache도 같은 내부 ALB를 사용합니다. 각 WEB이 특정 WAS 한 대에 고정되는 구조가 아닙니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p3-1">
          <mxGeometry x="72.0" y="1293.0" width="668.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p3-guide-3" value="&lt;b&gt;03 내부 ALB → WAS01&lt;/b&gt;&lt;br&gt;내부 ALB가 정상 상태의 WAS01을 선택하면 HTTP 8080으로 전달합니다. WAS 보안 그룹은 내부 ALB에서 온 요청만 받습니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p3-1">
          <mxGeometry x="72.0" y="1409.0" width="668.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p3-guide-4" value="&lt;b&gt;04 내부 ALB → WAS02&lt;/b&gt;&lt;br&gt;WAS02도 같은 방식으로 요청을 처리합니다. ASG와 두 AZ 배치는 가용성의 기반이며 지표에 따라 자동 증감하는 정책은 별도 보완 항목입니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p3-1">
          <mxGeometry x="760.0" y="1177.0" width="668.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p3-guide-5" value="&lt;b&gt;응답과 상태 확인&lt;/b&gt;&lt;br&gt;응답은 같은 연결의 역방향으로 돌아갑니다. 그림은 요청 방향만 표시합니다. ALB 상태 확인은 장애 대상을 제외하는 데 사용됩니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p3-1">
          <mxGeometry x="760.0" y="1293.0" width="668.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p3-guide-6" value="&lt;b&gt;운영 지원과 한계&lt;/b&gt;&lt;br&gt;Apache·Tomcat·애플리케이션 로그와 대상 상태/5xx 알람이 정의되어 있습니다. 내부 구간은 현재 HTTP이며 TLS 도입 필요성과 부하 기반 확장은 후속 검토 대상입니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p3-1">
          <mxGeometry x="760.0" y="1409.0" width="668.0" height="108" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
