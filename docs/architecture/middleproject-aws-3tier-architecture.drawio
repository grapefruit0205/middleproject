        <mxCell id="p2-nat" value="&lt;b&gt;NAT Gateway&lt;/b&gt;&lt;br&gt;outbound egress" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.nat_gateway;fillColor=#8C4FFF;gradientColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;spacingTop=6;" vertex="1" parent="p2-1">
