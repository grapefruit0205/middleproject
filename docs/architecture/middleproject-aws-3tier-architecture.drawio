        <mxCell id="p3-web-a" value="&lt;b&gt;WEB01&lt;/b&gt;&lt;br&gt;Apache reverse proxy" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;fillColor=#ED7100;gradientColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;spacingTop=6;" vertex="1" parent="p3-1">
