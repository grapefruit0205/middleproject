        <mxCell id="p3-ialb" value="&lt;b&gt;Internal ALB&lt;/b&gt;&lt;br&gt;nodes span AZ-A + AZ-C&lt;br&gt;listener HTTP 80" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;fillColor=#8C4FFF;gradientColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;spacingTop=6;" vertex="1" parent="p3-1">
