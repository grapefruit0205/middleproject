        <mxCell id="p6-korean-guide" value="" style="rounded=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;" vertex="1" parent="p6-1">
          <mxGeometry x="50" y="2225.0" width="1900.0" height="696" as="geometry" />
        </mxCell>
        <mxCell id="p6-guide-title" value="&lt;b&gt;한글 흐름 설명&lt;/b&gt; · 그림의 화살표 번호와 함께 읽으세요" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=21;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p6-1">
          <mxGeometry x="72" y="2243.0" width="1856.0" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p6-guide-1" value="&lt;b&gt;01~04 인터넷 → WEB&lt;/b&gt;&lt;br&gt;사용자 요청이 IGW를 거쳐 Public ALB에 도착합니다. ALB는 HTTPS를 처리하고 두 AZ의 정상 WEB 대상으로 HTTP 80 요청을 분산합니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p6-1">
          <mxGeometry x="72.0" y="2297.0" width="918.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p6-guide-2" value="&lt;b&gt;05~08 WEB → WAS&lt;/b&gt;&lt;br&gt;각 Apache가 내부 ALB로 프록시하고 내부 ALB가 WAS01/02에 HTTP 8080으로 전달합니다. 주황색 경로를 위에서 아래로 먼저 읽습니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p6-1">
          <mxGeometry x="72.0" y="2413.0" width="918.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p6-guide-3" value="&lt;b&gt;09~11 WAS → DB&lt;/b&gt;&lt;br&gt;두 WAS 모두 RDS 엔드포인트를 통해 기본 DB를 사용합니다. 회색 화살표는 대기 DB로의 동기 복제이며 별도 읽기 서비스나 두 활성 DB를 뜻하지 않습니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p6-1">
          <mxGeometry x="72.0" y="2529.0" width="918.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p6-guide-4" value="&lt;b&gt;12 스키마 적용&lt;/b&gt;&lt;br&gt;Flyway 전용 EC2가 마이그레이션 역할로 스키마를 적용합니다. 도식의 기본/대기 DB AZ는 개념 배치입니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p6-1">
          <mxGeometry x="72.0" y="2645.0" width="918.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p6-guide-5" value="&lt;b&gt;13~16 인증서·배포·egress&lt;/b&gt;&lt;br&gt;ACM은 ALB 인증서를 제공하고 S3는 배포 파일을 제공합니다. NAT는 private 인스턴스의 외부 통신 경로입니다. WEB/WAS의 동일한 지원 경로는 대표선으로 묶었습니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p6-1">
          <mxGeometry x="72.0" y="2761.0" width="918.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p6-guide-6" value="&lt;b&gt;17~20 권한·관리·비밀&lt;/b&gt;&lt;br&gt;IAM 역할이 서비스별 권한을 제한하고 SSM이 관리 접속을 제공합니다. Secrets Manager는 WAS와 Flyway가 허용된 비밀만 읽도록 연결됩니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p6-1">
          <mxGeometry x="1010.0" y="2297.0" width="918.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p6-guide-7" value="&lt;b&gt;21~22 기록과 관측&lt;/b&gt;&lt;br&gt;ALB 접근 로그는 S3에 저장되고 WEB/WAS 및 관련 서비스의 로그·지표는 CloudWatch에서 확인합니다. 연결선은 동일 역할 인스턴스의 대표선입니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p6-1">
          <mxGeometry x="1010.0" y="2413.0" width="918.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p6-guide-8" value="&lt;b&gt;23~25 비동기 예약 처리&lt;/b&gt;&lt;br&gt;WAS Outbox가 Scheduler 예약을 조정하고, 예약 시각에 SQS 메시지가 생성됩니다. WAS는 큐를 폴링해 중복 처리를 방지하며 소비합니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p6-1">
          <mxGeometry x="1010.0" y="2529.0" width="918.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p6-guide-9" value="&lt;b&gt;26~28 실패·발송·알람&lt;/b&gt;&lt;br&gt;반복 실패는 DLQ로 분리됩니다. SES가 활성화된 경우 WAS가 발송을 요청하며 CloudWatch가 큐와 실패 상태를 관측합니다. 불명확한 발송 결과는 무조건 재전송하지 않습니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p6-1">
          <mxGeometry x="1010.0" y="2645.0" width="918.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p6-guide-10" value="&lt;b&gt;지원 경로 읽는 법&lt;/b&gt;&lt;br&gt;좌우의 점선은 중앙 요청 흐름을 지원합니다. 같은 역할 전체에 적용되는 권한·배포·관리·관측은 대표 연결로 표시했습니다. 하단 개선 항목은 현재 구현과 구분해 읽습니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p6-1">
          <mxGeometry x="1010.0" y="2761.0" width="918.0" height="108" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>