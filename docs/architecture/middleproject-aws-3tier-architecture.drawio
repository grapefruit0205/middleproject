        </mxCell>
        <mxCell id="p3-was-a" value="&lt;b&gt;WAS01&lt;/b&gt;&lt;br&gt;Tomcat 10.1 + Spring Boot&lt;br&gt;ASG / IMDSv2" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;fillColor=#ED7100;gradientColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;spacingTop=6;" vertex="1" parent="p3-1">
          <mxGeometry x="285" y="680" width="76" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p3-was-c" value="&lt;b&gt;WAS02&lt;/b&gt;&lt;br&gt;Tomcat 10.1 + Spring Boot&lt;br&gt;ASG / IMDSv2" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;fillColor=#ED7100;gradientColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;spacingTop=6;" vertex="1" parent="p3-1">
          <mxGeometry x="765" y="680" width="76" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p3-panel" value="&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;Controls and evidence&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Traffic boundary&lt;/b&gt;&lt;br&gt;• WEB → internal ALB: HTTP 80&lt;br&gt;• internal ALB → WAS: HTTP 8080&lt;br&gt;• both paths are SG restricted&lt;br&gt;• WAS has no internet-facing listener&lt;br&gt;&lt;br&gt;&lt;b&gt;Availability&lt;/b&gt;&lt;br&gt;• WEB/WAS ASGs span AZ-A and AZ-C&lt;br&gt;• default min/desired/max: 2&lt;br&gt;• ALB health checks + rolling refresh&lt;br&gt;&lt;br&gt;&lt;b&gt;Observability&lt;/b&gt;&lt;br&gt;• Apache/Tomcat/application log groups&lt;br&gt;• target health and 5xx alarms&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B42318&quot;&gt;&lt;b&gt;Gaps&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• metric-based target tracking not deployed&lt;br&gt;• load profile is not yet proven&lt;br&gt;• internal TLS should be risk-reviewed" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#FFF8E8;strokeColor=#D99000;strokeWidth=2;fontColor=#172B4D;fontSize=13;" vertex="1" parent="p3-1">
          <mxGeometry x="1120" y="160" width="340" height="760" as="geometry" />
        </mxCell>
        <mxCell id="p3-e1" value="01 · HTTP 80" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=4;fontSize=12;endSize=13;fontStyle=1;fontColor=#C2410C;labelBackgroundColor=#FFFFFF;labelBorderColor=#CBD5E1;rounded=1;arcSize=16;jettySize=26;jumpStyle=arc;jumpSize=10;dashPattern=1 0;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="p3-1" source="p3-web-a" target="p3-ialb">
          <mxGeometry relative="1" as="geometry">
