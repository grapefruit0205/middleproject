        <mxCell id="p1-note" value="&lt;b&gt;Supporting services&lt;/b&gt; — NAT · ACM · IAM / Secrets Manager / SSM · CloudWatch · S3 · Scheduler / SQS / DLQ / SES&lt;br&gt;&lt;b&gt;읽는 순서&lt;/b&gt; — 02 Internet→WEB · 03 WEB→WAS · 04 WAS→Data/Async · 05 Well-Architected" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;fillColor=#FFF8E8;strokeColor=#D99000;fontColor=#5C4400;fontSize=12;" vertex="1" parent="p1-1">
