          <mxGeometry x="72" y="1143.0" width="1406.0" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p4-guide-1" value="&lt;b&gt;01 자격 증명 조회&lt;/b&gt;&lt;br&gt;WAS는 허용된 런타임 비밀을 Secrets Manager에서 조회합니다. 런타임·마이그레이션·소유자용 비밀의 접근 권한은 분리됩니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p4-1">
          <mxGeometry x="72.0" y="1197.0" width="693.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p4-guide-2" value="&lt;b&gt;02~03 동기 데이터 접근&lt;/b&gt;&lt;br&gt;WAS가 RDS 엔드포인트의 5432 포트로 연결하면 활성 기본 인스턴스에서 조회와 트랜잭션을 수행합니다. 대기 인스턴스는 일반 읽기 분산 대상이 아닙니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p4-1">
          <mxGeometry x="72.0" y="1313.0" width="693.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p4-guide-3" value="&lt;b&gt;04 스키마 변경&lt;/b&gt;&lt;br&gt;일시적으로 실행되는 Flyway EC2가 제한된 마이그레이션 권한으로 스키마를 적용합니다. 운영 WAS의 일반 요청 처리와 구분됩니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p4-1">
          <mxGeometry x="72.0" y="1429.0" width="693.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p4-guide-4" value="&lt;b&gt;05 Multi-AZ 복제&lt;/b&gt;&lt;br&gt;기본 DB의 변경이 다른 가용 영역의 대기 DB로 동기 복제됩니다. 기본/대기 AZ는 개념 배치이며 실제 배치와 장애 조치 후 역할은 달라질 수 있습니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p4-1">
          <mxGeometry x="72.0" y="1545.0" width="693.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p4-guide-5" value="&lt;b&gt;06~07 예약 등록과 전달&lt;/b&gt;&lt;br&gt;WAS의 Outbox 작업이 Scheduler 예약 생성·수정·삭제를 진행합니다. 예약 시각이 되면 Scheduler가 SQS에 메시지를 넣습니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p4-1">
          <mxGeometry x="785.0" y="1197.0" width="693.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p4-guide-6" value="&lt;b&gt;08 반복 실패 분리&lt;/b&gt;&lt;br&gt;설정된 수신 횟수 5회를 넘긴 반복 실패 메시지는 DLQ로 이동하고 14일간 보관됩니다. 운영자는 실패 원인을 확인할 수 있습니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p4-1">
          <mxGeometry x="785.0" y="1313.0" width="693.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p4-guide-7" value="&lt;b&gt;09~10 소비와 발송&lt;/b&gt;&lt;br&gt;WAS 소비자가 큐를 폴링하고 중복 처리 방지 로직을 거쳐, 활성화된 경우 SES에 발송을 요청합니다. 소비자 아이콘은 위 WAS와 같은 애플리케이션 역할입니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p4-1">
          <mxGeometry x="785.0" y="1429.0" width="693.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p4-guide-8" value="&lt;b&gt;11 관측과 결과 해석&lt;/b&gt;&lt;br&gt;CloudWatch는 큐 지연·적체·DLQ·발송 실패를 관측합니다. SES 수락은 수신함 도착과 같지 않으며 결과를 알 수 없는 발송은 성공으로 표시하거나 무조건 재시도하지 않습니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p4-1">
          <mxGeometry x="785.0" y="1545.0" width="693.0" height="108" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p5-well-architected" name="05 Well-Architected">
    <mxGraphModel dx="1200" dy="2228" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="2228" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="p5-0" />
        <mxCell id="p5-1" parent="p5-0" />
        <mxCell id="p5-title" value="&lt;b&gt;05 · AWS Well-Architected Source Review&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=27;fontColor=#172B4D;" vertex="1" parent="p5-1">
          <mxGeometry x="40" y="25" width="1120" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p5-banner" value="저장소 소스에서 확인한 설계 통제와 보완점을 요약한 검토입니다. AWS 인증이나 현재 운영 환경의 준수 보장이 아닙니다." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;fillColor=#FFF4CE;strokeColor=#E3B341;fontColor=#5C4400;fontSize=13;" vertex="1" parent="p5-1">
          <mxGeometry x="40" y="85" width="1120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5-ops" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;1. Operational Excellence&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#176B2C&quot;&gt;&lt;b&gt;확인&lt;/b&gt;&lt;/font&gt; Terraform, CloudWatch logs/alarms, SSM, rolling refresh&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B42318&quot;&gt;&lt;b&gt;보완&lt;/b&gt;&lt;/font&gt; 운영 런북·자동 대응·복구 리허설의 최신 증거" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#EEF6FF;strokeColor=#147EBA;strokeWidth=2;fontColor=#172B4D;fontSize=13;" vertex="1" parent="p5-1">
          <mxGeometry x="50" y="190" width="530" height="300" as="geometry" />
        </mxCell>
        <mxCell id="p5-security" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;2. Security&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#176B2C&quot;&gt;&lt;b&gt;확인&lt;/b&gt;&lt;/font&gt; private/isolated tiers, SG chain, IAM/Secrets, encryption, IMDSv2, no SSH&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B42318&quot;&gt;&lt;b&gt;보완&lt;/b&gt;&lt;/font&gt; WAF, VPC endpoints, internal TLS 위험 검토" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#FFF0F2;strokeColor=#DD344C;strokeWidth=2;fontColor=#172B4D;fontSize=13;" vertex="1" parent="p5-1">
          <mxGeometry x="620" y="190" width="530" height="300" as="geometry" />
        </mxCell>
        <mxCell id="p5-reliability" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;3. Reliability&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#176B2C&quot;&gt;&lt;b&gt;확인&lt;/b&gt;&lt;/font&gt; 2-AZ ASGs, RDS Multi-AZ default, backups, SQS/DLQ, Outbox/idempotency&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B42318&quot;&gt;&lt;b&gt;보완&lt;/b&gt;&lt;/font&gt; restore/failover test, RTO/RPO, DR game day" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F2F8EC;strokeColor=#248814;strokeWidth=2;fontColor=#172B4D;fontSize=13;" vertex="1" parent="p5-1">
          <mxGeometry x="50" y="530" width="530" height="300" as="geometry" />
        </mxCell>
        <mxCell id="p5-performance" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;4. Performance Efficiency&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#176B2C&quot;&gt;&lt;b&gt;확인&lt;/b&gt;&lt;/font&gt; ALB/ASG 확장 발판, tier health checks, managed RDS, async queue&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B42318&quot;&gt;&lt;b&gt;보완&lt;/b&gt;&lt;/font&gt; metric target tracking과 부하 테스트 기준선" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F6F1FA;strokeColor=#7657A9;strokeWidth=2;fontColor=#172B4D;fontSize=13;" vertex="1" parent="p5-1">
          <mxGeometry x="620" y="530" width="530" height="300" as="geometry" />
        </mxCell>
        <mxCell id="p5-cost" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;5. Cost Optimization&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#176B2C&quot;&gt;&lt;b&gt;확인&lt;/b&gt;&lt;/font&gt; capacity variables, dev/HA NAT strategy, ephemeral migration, S3 lifecycle, cost tags&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B42318&quot;&gt;&lt;b&gt;보완&lt;/b&gt;&lt;/font&gt; budgets/anomaly alerts와 사용량 기반 right-sizing" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#FFF8E8;strokeColor=#D99000;strokeWidth=2;fontColor=#172B4D;fontSize=13;" vertex="1" parent="p5-1">
          <mxGeometry x="50" y="870" width="530" height="300" as="geometry" />
        </mxCell>
        <mxCell id="p5-sustainability" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;6. Sustainability&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#176B2C&quot;&gt;&lt;b&gt;확인&lt;/b&gt;&lt;/font&gt; managed services, Graviton RDS default, lifecycle, ephemeral workload&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B42318&quot;&gt;&lt;b&gt;보완&lt;/b&gt;&lt;/font&gt; demand-based scale-in과 사용률/효율 측정" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#EEF8F1;strokeColor=#2E7D32;strokeWidth=2;fontColor=#172B4D;fontSize=13;" vertex="1" parent="p5-1">
          <mxGeometry x="620" y="870" width="530" height="300" as="geometry" />
        </mxCell>
        <mxCell id="p5-priority" value="&lt;b&gt;권장 순서&lt;/b&gt; ① restore/failover로 복구 가능성 입증 → ② WAF/endpoints로 노출·egress 축소 → ③ 부하 측정 후 metric scaling → ④ 비용·지속가능성 측정 자동화" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;fillColor=#E8F0FE;strokeColor=#4C6FFF;fontColor=#243B7A;fontSize=14;" vertex="1" parent="p5-1">
          <mxGeometry x="50" y="1225" width="1100" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p5-source" value="Official basis: AWS Well-Architected Framework — Six Pillars · Reliability — Workload Architecture / Fault Isolation / Shared Responsibility for Resiliency" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5E6C84;" vertex="1" parent="p5-1">
          <mxGeometry x="50" y="1340" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p5-korean-guide" value="" style="rounded=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;" vertex="1" parent="p5-1">
          <mxGeometry x="50" y="1455.0" width="1100.0" height="728" as="geometry" />
        </mxCell>
        <mxCell id="p5-guide-title" value="&lt;b&gt;한글 흐름 설명&lt;/b&gt; · 그림의 화살표 번호와 함께 읽으세요" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=21;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p5-1">
          <mxGeometry x="72" y="1473.0" width="1056.0" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p5-guide-1" value="&lt;b&gt;운영 우수성과 보안&lt;/b&gt;&lt;br&gt;Terraform과 로그·알람은 반복 가능한 운영의 기반입니다. private/isolated 서브넷, 보안 그룹, IAM 역할과 비밀 분리는 접근 범위를 제한합니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p5-1">
          <mxGeometry x="72.0" y="1527.0" width="1056.0" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p5-guide-2" value="&lt;b&gt;신뢰성&lt;/b&gt;&lt;br&gt;두 AZ의 ASG, RDS Multi-AZ, 백업, SQS/DLQ는 장애 대응의 구성 요소입니다. 실제 복구 능력은 복원·장애 조치 시험과 RTO/RPO 측정으로 확인해야 합니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p5-1">
          <mxGeometry x="72.0" y="1629.0" width="1056.0" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p5-guide-3" value="&lt;b&gt;성능 효율성&lt;/b&gt;&lt;br&gt;ALB와 ASG는 확장할 수 있는 구조를 제공합니다. 실제 트래픽 기준선과 목표 지표를 정한 뒤 자동 확장 정책을 연결하는 순서입니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p5-1">
          <mxGeometry x="72.0" y="1731.0" width="1056.0" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p5-guide-4" value="&lt;b&gt;비용과 지속가능성&lt;/b&gt;&lt;br&gt;용량 변수, 로그 보관 기간, 일시 작업 노드는 낭비를 줄이는 수단입니다. 실제 사용량과 비용을 측정해야 적절한 크기를 판단할 수 있습니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p5-1">
          <mxGeometry x="72.0" y="1833.0" width="1056.0" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p5-guide-5" value="&lt;b&gt;이 페이지의 의미&lt;/b&gt;&lt;br&gt;초록 표시는 소스에서 확인한 구성, 빨간 표시는 미구현 또는 증거가 필요한 항목입니다. 각 권장 서비스의 도입 여부는 요구사항과 비용을 함께 보고 결정합니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p5-1">
          <mxGeometry x="72.0" y="1935.0" width="1056.0" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p5-guide-6" value="&lt;b&gt;검토 범위&lt;/b&gt;&lt;br&gt;이 도식은 현재 저장소를 설명합니다. 운영 중인 AWS 환경을 조회하거나 Well-Architected 심사를 수행한 결과는 아닙니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p5-1">
          <mxGeometry x="72.0" y="2037.0" width="1056.0" height="94" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p6-all-in-one" name="06 통합 상세도">
    <mxGraphModel dx="2000" dy="2966" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="2966" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="p6-0" />
        <mxCell id="p6-1" parent="p6-0" />
        <mxCell id="p6-title" value="&lt;b&gt;06 · Middleproject AWS 3-Tier — All-in-One Detail&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontColor=#172B4D;" vertex="1" parent="p6-1">
          <mxGeometry x="40" y="20" width="1920" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p6-sub" value="1페이지의 세로 흐름에 네트워크·보안·배포·관측·비동기·데이터 구성을 모두 겹쳐 표시한 통합 검토용 페이지" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#5E6C84;" vertex="1" parent="p6-1">
          <mxGeometry x="40" y="65" width="1920" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p6-user" value="&lt;b&gt;User / Browser&lt;/b&gt;" style="shape=mxgraph.basic.person;html=1;fillColor=#FFFFFF;strokeColor=#172B4D;strokeWidth=2;fontSize=12;verticalLabelPosition=bottom;verticalAlign=top;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;spacingTop=6;" vertex="1" parent="p6-1">
          <mxGeometry x="960" y="105" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6-cloud" value="&lt;b&gt;AWS Cloud — ap-northeast-2 (Seoul)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#F3F8FC;strokeColor=#147EBA;strokeWidth=2;fontColor=#174A67;fontSize=15;" vertex="1" parent="p6-1">
          <mxGeometry x="90" y="220" width="1820" height="1880" as="geometry" />
        </mxCell>
        <mxCell id="p6-vpc" value="&lt;b&gt;VPC 10.20.0.0/16 · ap-northeast-2a + ap-northeast-2c&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#F7FBF2;strokeColor=#248814;strokeWidth=2;fontColor=#1F5B16;fontSize=14;" vertex="1" parent="p6-1">
          <mxGeometry x="405" y="285" width="1190" height="1610" as="geometry" />
        </mxCell>
        <mxCell id="p6-az-head-a" value="&lt;b&gt;Availability Zone A&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#147EBA;fontColor=#0D47A1;fontSize=13;" vertex="1" parent="p6-1">
          <mxGeometry x="520" y="345" width="410" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p6-az-head-c" value="&lt;b&gt;Availability Zone C&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#147EBA;fontColor=#0D47A1;fontSize=13;" vertex="1" parent="p6-1">
          <mxGeometry x="1070" y="345" width="410" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p6-igw" value="&lt;b&gt;Internet Gateway&lt;/b&gt;" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.internet_gateway;fillColor=#8C4FFF;gradientColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;spacingTop=6;" vertex="1" parent="p6-1">
