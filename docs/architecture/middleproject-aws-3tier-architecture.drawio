        </mxCell>
        <mxCell id="p2-alb" value="&lt;b&gt;Public ALB&lt;/b&gt;&lt;br&gt;nodes span AZ-A + AZ-C&lt;br&gt;HTTPS 443" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;fillColor=#8C4FFF;gradientColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;spacingTop=6;" vertex="1" parent="p2-1">
          <mxGeometry x="530" y="390" width="76" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2-web-a" value="&lt;b&gt;WEB01&lt;/b&gt;&lt;br&gt;Apache 2.4&lt;br&gt;ASG / IMDSv2" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;fillColor=#ED7100;gradientColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;spacingTop=6;" vertex="1" parent="p2-1">
          <mxGeometry x="285" y="675" width="76" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2-web-c" value="&lt;b&gt;WEB02&lt;/b&gt;&lt;br&gt;Apache 2.4&lt;br&gt;ASG / IMDSv2" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;fillColor=#ED7100;gradientColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;spacingTop=6;" vertex="1" parent="p2-1">
          <mxGeometry x="765" y="675" width="76" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2-panel" value="&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;Controls and evidence&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Ingress&lt;/b&gt;&lt;br&gt;• ACM certificate + TLS 1.3 policy&lt;br&gt;• internet → ALB: 443 only&lt;br&gt;• ALB → WEB: 80, SG restricted&lt;br&gt;• Public ALB blocks /api/mcp paths&lt;br&gt;&lt;br&gt;&lt;b&gt;Operations&lt;/b&gt;&lt;br&gt;• private/versioned artifact S3&lt;br&gt;• ALB access-log S3 + CloudWatch alarms&lt;br&gt;• SSM managed access, no SSH ingress&lt;br&gt;• encrypted gp3 + IMDSv2&lt;br&gt;&lt;br&gt;&lt;b&gt;Egress&lt;/b&gt;&lt;br&gt;• private WEB routes through NAT&lt;br&gt;• dev: single zonal NAT / HA: regional NAT&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B42318&quot;&gt;&lt;b&gt;Gap: AWS WAF and VPC endpoints are not deployed.&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#FFF8E8;strokeColor=#D99000;strokeWidth=2;fontColor=#172B4D;fontSize=13;" vertex="1" parent="p2-1">
          <mxGeometry x="1120" y="160" width="340" height="760" as="geometry" />
        </mxCell>
        <mxCell id="p2-e1" value="01 · HTTPS 443" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=4;fontSize=12;endSize=13;fontStyle=1;fontColor=#C2410C;labelBackgroundColor=#FFFFFF;labelBorderColor=#CBD5E1;rounded=1;arcSize=16;jettySize=26;jumpStyle=arc;jumpSize=10;dashPattern=1 0;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="p2-1" source="p2-user" target="p2-igw">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-e2" value="02" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=4;endSize=13;fontSize=12;fontStyle=1;fontColor=#C2410C;labelBackgroundColor=#FFFFFF;labelBorderColor=#CBD5E1;rounded=1;arcSize=16;jettySize=26;jumpStyle=arc;jumpSize=10;dashPattern=1 0;exitX=1;exitY=0.5;exitPerimeter=0;entryX=1;entryY=0.5;entryPerimeter=0;" edge="1" parent="p2-1" source="p2-igw" target="p2-alb">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="701.0" y="205.0" />
              <mxPoint x="701.0" y="428.0" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-e3" value="03 · HTTP 80" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=4;fontSize=12;endSize=13;fontStyle=1;fontColor=#C2410C;labelBackgroundColor=#FFFFFF;labelBorderColor=#CBD5E1;rounded=1;arcSize=16;jettySize=26;jumpStyle=arc;jumpSize=10;dashPattern=1 0;exitX=0;exitY=0.5;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="p2-1" source="p2-alb" target="p2-web-a">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="495.0" y="428.0" />
              <mxPoint x="495.0" y="640.0" />
              <mxPoint x="323.0" y="640.0" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-e4" value="04 · HTTP 80" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=4;fontSize=12;endSize=13;fontStyle=1;fontColor=#C2410C;labelBackgroundColor=#FFFFFF;labelBorderColor=#CBD5E1;rounded=1;arcSize=16;jettySize=26;jumpStyle=arc;jumpSize=10;dashPattern=1 0;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="p2-1" source="p2-alb" target="p2-web-c">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="641.0" y="428.0" />
              <mxPoint x="641.0" y="640.0" />
              <mxPoint x="803.0" y="640.0" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-e5" value="05 · HTTPS egress" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#15803D;strokeWidth=3;dashed=1;fontSize=12;endSize=13;fontStyle=1;fontColor=#15803D;labelBackgroundColor=#FFFFFF;labelBorderColor=#CBD5E1;rounded=1;arcSize=16;jettySize=26;jumpStyle=arc;jumpSize=10;dashPattern=8 5;exitX=0;exitY=0.5;exitPerimeter=0;entryX=1;entryY=0.5;entryPerimeter=0;" edge="1" parent="p2-1" source="p2-web-a" target="p2-nat">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-korean-guide" value="" style="rounded=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;" vertex="1" parent="p2-1">
          <mxGeometry x="50" y="1105.0" width="1400.0" height="464" as="geometry" />
        </mxCell>
        <mxCell id="p2-guide-title" value="&lt;b&gt;한글 흐름 설명&lt;/b&gt; · 그림의 화살표 번호와 함께 읽으세요" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=21;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p2-1">
          <mxGeometry x="72" y="1123.0" width="1356.0" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2-guide-1" value="&lt;b&gt;01 외부 요청&lt;/b&gt;&lt;br&gt;사용자가 HTTPS 443으로 접속합니다. 인터넷 게이트웨이는 VPC의 인터넷 경로를 제공하고 실제 TLS 처리는 ALB가 담당합니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p2-1">
          <mxGeometry x="72.0" y="1177.0" width="668.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p2-guide-2" value="&lt;b&gt;02 Public ALB&lt;/b&gt;&lt;br&gt;두 public 서브넷에 걸친 ALB가 ACM 인증서와 TLS 정책을 적용합니다. /api/mcp 경로는 외부 ALB에서 차단됩니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p2-1">
          <mxGeometry x="72.0" y="1293.0" width="668.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p2-guide-3" value="&lt;b&gt;03 가용 영역 A의 WEB&lt;/b&gt;&lt;br&gt;ALB가 상태 확인을 통과한 WEB01로 HTTP 80 요청을 보냅니다. 해당 연결은 ALB 보안 그룹에서 WEB 보안 그룹으로 제한됩니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p2-1">
          <mxGeometry x="72.0" y="1409.0" width="668.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p2-guide-4" value="&lt;b&gt;04 가용 영역 C의 WEB&lt;/b&gt;&lt;br&gt;WEB02도 같은 대상 그룹에서 요청을 받습니다. 두 인스턴스는 ASG의 대표 배치이며 ALB는 요청마다 정상 대상을 선택합니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p2-1">
          <mxGeometry x="760.0" y="1177.0" width="668.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p2-guide-5" value="&lt;b&gt;05 외부로 나가는 통신&lt;/b&gt;&lt;br&gt;초록 점선은 WEB의 외부 HTTPS 통신을 나타냅니다. 개발 구성은 단일 zonal NAT, HA 구성은 regional NAT를 사용합니다. 다른 private 인스턴스의 동일한 egress 경로는 대표선으로 읽습니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p2-1">
          <mxGeometry x="760.0" y="1293.0" width="668.0" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p2-guide-6" value="&lt;b&gt;지원 구성 읽기&lt;/b&gt;&lt;br&gt;ACM은 인증서, S3는 배포 파일과 ALB 접근 로그, SSM은 관리 접속, CloudWatch는 로그·알람을 제공합니다. 이 항목은 요청 경로 옆의 보조 설명에 정리되어 있습니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p2-1">
          <mxGeometry x="760.0" y="1409.0" width="668.0" height="108" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p3-web-was" name="03 WEB → WAS">
