        <mxCell id="p1-korean-guide" value="" style="rounded=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;" vertex="1" parent="p1-1">
          <mxGeometry x="50" y="1560.0" width="1000.0" height="728" as="geometry" />
        </mxCell>
        <mxCell id="p1-guide-title" value="&lt;b&gt;한글 흐름 설명&lt;/b&gt; · 그림의 화살표 번호와 함께 읽으세요" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=21;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p1-1">
          <mxGeometry x="72" y="1578.0" width="956.0" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p1-guide-1" value="&lt;b&gt;01 사용자 접속&lt;/b&gt;&lt;br&gt;브라우저가 HTTPS로 접속하면 인터넷 게이트웨이를 통해 VPC에 연결됩니다. 인터넷 게이트웨이는 네트워크 출입구이며 요청을 처리하는 서버는 아닙니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p1-1">
          <mxGeometry x="72.0" y="1632.0" width="956.0" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p1-guide-2" value="&lt;b&gt;02 HTTPS 종단&lt;/b&gt;&lt;br&gt;Public ALB가 443번 포트에서 요청을 받아 ACM 인증서로 TLS 연결을 처리합니다. ALB는 두 가용 영역에 걸쳐 동작합니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p1-1">
          <mxGeometry x="72.0" y="1734.0" width="956.0" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p1-guide-3" value="&lt;b&gt;03 WEB 계층 전달&lt;/b&gt;&lt;br&gt;ALB는 정상 상태의 Apache WEB 인스턴스로 HTTP 80 요청을 분산합니다. WEB 보안 그룹은 Public ALB에서 온 요청만 허용합니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p1-1">
          <mxGeometry x="72.0" y="1836.0" width="956.0" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p1-guide-4" value="&lt;b&gt;04 내부 서비스 진입&lt;/b&gt;&lt;br&gt;Apache가 애플리케이션 요청을 내부 ALB의 HTTP 80으로 프록시합니다. 내부 ALB는 private WAS 서브넷에 배치됩니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p1-1">
          <mxGeometry x="72.0" y="1938.0" width="956.0" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p1-guide-5" value="&lt;b&gt;05 WAS 계층 실행&lt;/b&gt;&lt;br&gt;내부 ALB가 Tomcat/Spring Boot의 8080 포트로 요청을 전달합니다. WAS가 일정 등록·수정·취소와 조회를 처리합니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p1-1">
          <mxGeometry x="72.0" y="2040.0" width="956.0" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p1-guide-6" value="&lt;b&gt;06 데이터 저장&lt;/b&gt;&lt;br&gt;WAS가 RDS 엔드포인트의 5432 포트를 통해 PostgreSQL을 사용합니다. Multi-AZ 대기 인스턴스는 장애 조치를 위한 구성입니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#172B4D;spacing=5;overflow=hidden;" vertex="1" parent="p1-1">
          <mxGeometry x="72.0" y="2142.0" width="956.0" height="94" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
