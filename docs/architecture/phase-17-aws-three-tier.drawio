          <mxCell id="security-note" value="&lt;b&gt;Security groups:&lt;/b&gt; Internet→public ALB :443; public ALB→WEB :80; WEB→internal ALB :80; internal ALB→WAS :8080; WAS→RDS :5432. No inbound SSH. DB subnets have no internet route." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=1.5;strokeColor=#147EBA;fillColor=#F2F8FF;arcSize=8;" vertex="1" parent="1"><mxGeometry x="110" y="1140" width="1480" height="55" as="geometry" /></mxCell>
          <mxCell id="mcp-note" value="&lt;b&gt;Public MCP guard:&lt;/b&gt; requests to /api/mcp on the public virtual host return 403. Only the loopback Apache listener accepts MCP traffic from tunnel-client." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=1.5;strokeColor=#DD344C;fillColor=#FFF0F0;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1650" y="1147" width="470" height="52" as="geometry" /></mxCell>
