# Local-only values. Copy to .env and set three different DB passwords.
LOCAL_WEB_PORT=8088
LOCAL_DB_ADMIN_PASSWORD=
LOCAL_DB_MIGRATION_PASSWORD=
LOCAL_DB_APP_PASSWORD=
LOCAL_OWNER_ID=local-owner
# Keep LOCAL_OWNER_ID unchanged when reusing an existing database volume.
# Local loopback mode does not require LOCAL_OWNER_TOKEN; AWS still requires auth.
